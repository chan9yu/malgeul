{
	"mcpServers": {
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp"
		},
		"playwright": {
			"args": ["-y", "@playwright/mcp@latest"],
			"command": "npx",
			"type": "stdio"
		},
		"sequential-thinking": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
		},
		"serena": {
			"command": "uvx",
			"args": [
				"--from",
				"git+https://github.com/oraios/serena",
				"serena",
				"start-mcp-server",
				"--context=claude-code",
				"--project-from-cwd",
				"--open-web-dashboard=false"
			]
		}
	}
}
